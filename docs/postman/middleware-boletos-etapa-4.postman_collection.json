{
  "info": {
    "_postman_id": "b0a38977-8d5c-4f56-bc1a-cb6f045a4e40",
    "name": "middleware-boletos - Etapa 4",
    "description": "Validação do painel operacional, dashboard e módulo Compliance/Blacklist da Etapa 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tenant Etapa 4\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tenants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"response has data\", function () {",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "});",
                  "",
                  "pm.test(\"tenantId is captured\", function () {",
                  "  pm.expect(json.data.id).to.exist;",
                  "  pm.collectionVariables.set(\"tenantId\", json.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {

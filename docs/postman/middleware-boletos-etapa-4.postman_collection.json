    {
      "name": "Compliance",
      "item": [
        {
          "name": "Create Blacklist Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"123.456.789-00\",\n  \"name\": \"Cliente Compliance\",\n  \"reason\": \"Solicitação do cliente\",\n  \"notes\": \"Não emitir novas cobranças.\",\n  \"source\": \"MANUAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/blacklist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"response has data\", function () {",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "});",
                  "",
                  "pm.test(\"blacklistId is captured\", function () {",
                  "  pm.expect(json.data.id).to.exist;",
                  "  pm.collectionVariables.set(\"blacklistId\", json.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Check Blacklist Blocked",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/blacklist/check?document=123.456.789-00"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"document is blocked\", function () {",
                  "  pm.expect(json).to.have.property(\"blocked\", true);",
                  "  pm.expect(json).to.have.property(\"reason\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate Blacklist Entry - 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"12345678900\",\n  \"name\": \"Cliente Compliance\",\n  \"reason\": \"Duplicado\",\n  \"source\": \"MANUAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/blacklist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"error code is DUPLICATE_RESOURCE\", function () {",
                  "  pm.expect(json).to.have.property(\"error\");",
                  "  pm.expect(json.error).to.have.property(\"code\", \"DUPLICATE_RESOURCE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unblock Blacklist Entry",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/blacklist/{{blacklistId}}/unblock"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"response has data\", function () {",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"entry is inactive\", function () {",
                  "  pm.expect(json.data).to.have.property(\"active\", false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Block Blacklist Entry",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/blacklist/{{blacklistId}}/block"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"response has data\", function () {",

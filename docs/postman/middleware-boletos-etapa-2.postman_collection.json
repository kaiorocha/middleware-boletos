    {
      "name": "Duplicate Validation",
      "item": [
        {
          "name": "Create Duplicate User With Same Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"email\": \"usuario.demo@example.com\",\n  \"name\": \"Usuário Demo Duplicado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"response has duplicate error\", function () {",
                  "  pm.expect(json).to.have.property(\"error\");",
                  "  pm.expect(json.error).to.have.property(\"code\", \"DUPLICATE_RESOURCE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Duplicate Customer With Same Document",
          "request": {
            "method": "POST",
            "header": [
              {

{
  "name": "middleware-boletos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-openapi": "if [ -f ../docs/openapi/middleware-boletos-etapa-5.openapi.json ]; then mkdir -p public && cp ../docs/openapi/middleware-boletos-etapa-5.openapi.json public/openapi.json; fi",
    "predev": "npm run sync-openapi",
    "dev": "next dev -p 3000",
    "prebuild": "npm run sync-openapi",
    "build": "next build --webpack",
    "start": "next start -p 3000"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.1.6"
  }
}

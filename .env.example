# Application
# APP_ENV values: development | staging | production
PORT=8080
APP_ENV=development
BACKEND_ENV=development

# Authentication
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=

# Admin bootstrap (only for local/dev convenience)
ENABLE_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Frontend
FRONTEND_PORT=3000
FRONTEND_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=

# Database
# Provide a full DATABASE_URL in production (do not commit credentials)
DATABASE_URL=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1800
DB_CONN_MAX_IDLE_TIME=300

# Redis
REDIS_URL=
